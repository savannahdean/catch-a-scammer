# Caddy gets and renews the HTTPS certificate for DOMAIN by itself, as soon as
# the domain's DNS points at this server and ports 80 and 443 are open.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# www.yourdomain -> yourdomain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
