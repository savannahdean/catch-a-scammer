# Production settings. Copy to deploy/.env on the server and fill it in.
# deploy/.env is never committed (it holds the database password).

# Your domain, without https:// (its DNS A record must point at this server).
DOMAIN=yourgame.com

# A long random password. Make one on the server with:  openssl rand -hex 24
DB_PASSWORD=change-me

# The research study. Leave it off until you have approval to collect data
# from the public (see docs/STUDY_DATA.md). on = the title screen offers it.
STUDY_ENABLED=off

# Which shared world gets generated on the first start.
WORLD_SEED=1337

# Rate limits per player IP, as count/seconds.
RATE_NEW_CASE=20/3600
RATE_MESSAGE=40/60
RATE_JOIN_STUDY=10/3600
RATE_ANSWERS=20/3600
