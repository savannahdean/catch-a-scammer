# Local Postgres in Docker. Start it with:  docker compose up -d
# (credentials match docker-compose.yml). Keep this file out of git and
# never put this string in the C++ client.
DATABASE_URL=postgresql://cas:cas@localhost:5432/osint

API_PORT=8000
WORLD_SEED=1337
DB_POOL_MAX=5

# Switches (on/off). All on for local development; deploy/compose.yml sets
# LEGACY_API and API_DOCS off on the public server. See server/guard.py.
STUDY_ENABLED=on
LEGACY_API=on
API_DOCS=on
